#cloud-config
# Minimal seed for ephemeral test VMs. Add per-VM customizations under
# vm/cloudinit/overlays/<vm-name>/ rather than editing this file.

ssh_pwauth: false
disable_root: true

# Inject the per-VM key into the named target user (set in
# vm/targets/<target>.env via DEFAULT_USER) plus the cloud-init default
# user. This covers two cases: Fedora Cloud, where the default user is
# fedora and our DEFAULT_USER matches; and bootc-derived images, where
# the user is created during the bib build (e.g. core) and cloud-init's
# notion of "default user" differs from the image's actual login user.
users:
  - default
  - name: ${DEFAULT_USER}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [wheel]
    shell: /bin/bash
    ssh_authorized_keys:
      - ${SSH_PUBKEY}

ssh_authorized_keys:
  - ${SSH_PUBKEY}

# Skip dnf update on first boot — testing is faster and reproducible against
# a known-baseline image. Re-enable per-VM via overlay if you need fresh pkgs.
package_update: false
package_upgrade: false

runcmd:
  - [ "sh", "-c", "printf 'provisioned by scripts/vm/ on %s\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > /etc/motd" ]

final_message: "scripts/vm seed applied; uptime $UPTIME, datasource $DSNAME"
