#cloud-config
# Minimal seed for ephemeral test VMs. Add per-VM customizations under
# vm/cloudinit/overlays/<vm-name>/ rather than editing this file.

ssh_pwauth: false
disable_root: true

# Inject the per-VM key into the named target user (set in
# vm/targets/<target>.env via DEFAULT_USER). On Fedora Cloud Base this
# operates on the pre-existing `fedora` user (idempotent modify); on
# bootc-derived images it operates on the user created at bib time
# (e.g. `core` from kinoite.toml's [[customizations.user]] block).
#
# We do NOT include cloud-init's `- default` user. On Fedora Kinoite,
# `default` resolves to `fedora` with default groups `[adm,
# systemd-journal, wheel]` — `adm` and `systemd-journal` don't exist
# in stock Kinoite, so useradd fails and aborts the users module.
users:
  - name: ${DEFAULT_USER}
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [wheel]
    shell: /bin/bash
    ssh_authorized_keys:
      - ${SSH_PUBKEY}

ssh_authorized_keys:
  - ${SSH_PUBKEY}

# Skip dnf update on first boot — testing is faster and reproducible against
# a known-baseline image. Re-enable per-VM via overlay if you need fresh pkgs.
package_update: false
package_upgrade: false

# Use write_files (not runcmd) — see _apply_overlay in cloudinit.sh
# for why duplicate top-level keys at this layer are unsafe.
write_files:
  - path: /etc/motd
    owner: root:root
    permissions: '0644'
    content: |
      provisioned by scripts/vm/ on ${BUILD_DATE}

final_message: "scripts/vm seed applied; uptime $UPTIME, datasource $DSNAME"
