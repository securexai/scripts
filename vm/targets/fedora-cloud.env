# Pinned upstream qcow2 for the Fedora 43 Cloud Base image.
# Sourced by vm/scripts/lib/images.sh::ensure_image.
#
# To update IMAGE_SHA256 (do this once per Fedora point release):
#   curl -fsSL https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-43-x86_64-CHECKSUM \
#     | grep -E '^SHA256.*Fedora-Cloud-Base.*x86_64\.qcow2'
# Pin the resulting hex digest below.
#
# When Fedora cuts a 43-1.X point release with a new qcow2 filename, update
# IMAGE_URL too. The monthly toolbox-bump routine does NOT touch this file —
# Fedora cloud image bumps are a separate cadence.

IMAGE_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/43/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-43-1.6.x86_64.qcow2"

# Pinned 2026-04-25 from getfedora.org/releases.json (Cloud_Base / x86_64 / 43).
# Bump in lockstep with IMAGE_URL when Fedora cuts a new 43-1.x point release.
IMAGE_SHA256="846574c8a97cd2d8dc1f231062d73107cc85cbbbda56335e264a46e3a6c8ab2f"

# virt-install knobs (consumed by vm/scripts/subcommands/create.sh).
OS_VARIANT="fedora43"
DEFAULT_VCPUS="2"
DEFAULT_MEM_MIB="2048"
DEFAULT_DISK_GIB="10"
DEFAULT_USER="fedora"
