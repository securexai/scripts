# Pinned upstream OCI image + bootc-image-builder config for the Fedora 44
# Kinoite VM target. Sourced by vm/scripts/lib/bib.sh::build_kinoite_qcow.
#
# Stock fedora-ostree-desktops/kinoite:44 ships without cloud-init, so we
# build a derived OCI (vm/Containerfile.kinoite-44) that layers it in,
# then bib that. Same pattern the F43 kinoite.env uses with
# vm/Containerfile.bootc on centos-bootc:stream9.
#
# One-time per OCI bump (and after the very first checkout):
#   sudo podman build -t localhost/scripts-vm-kinoite-44:latest \
#     -f vm/Containerfile.kinoite-44 vm/
#   # then capture the local image ID and pin it below
#   sudo podman inspect --format '{{.Id}}' localhost/scripts-vm-kinoite-44:latest
#
# Then run the bib pipeline (slow — 10–25 min, cached):
#   BIB_ROOTFUL=1 ./vm/scripts/vm build-kinoite --target kinoite-44

OCI_REF="localhost/scripts-vm-kinoite-44:latest"

# FIXME: pin after first `sudo podman build` of the derived OCI. For
# bare `localhost/...` refs, OCI_DIGEST records the local image ID
# (sudo podman inspect --format '{{.Id}}'); cache-hit logic compares
# against this so a rebuild of the derived image invalidates correctly.
# An empty value here causes the bib pipeline to fail loudly until pinned.
OCI_DIGEST=""

# FIXME: pin a specific bib release tag once the first successful build
# is in. Upstream bib has no GitHub release tags published as of 2026-04-29
# (only the floating "latest" tag); R-003 stays open.
BIB_VERSION="latest"

# Path to the bib config TOML, relative to vm/targets/. Reuses kinoite.toml
# verbatim — same `core` user + cloud-init service enabling.
BIB_CONFIG_REL="kinoite.toml"

# Fedora bootc bases (kinoite, fedora-bootc) intentionally don't declare
# a default rootfs — bib hard-fails with "missing required info:
# DefaultRootFs" without --rootfs. btrfs matches the F44 Cloud Base
# default ("Btrfs subvolume for the /boot partition" — Fedora Magazine
# F44 announcement) so derived VMs stay layout-consistent. Caveat: with
# btrfs, bib does not support custom mountpoints under /var at build
# time (osbuild.org/docs/bootc/). Acceptable for this rig. R-017.
BIB_ROOTFS="btrfs"

# virt-install knobs (consumed by vm/scripts/subcommands/create.sh).
# OS_VARIANT note: same fedora-unknown caveat as fedora-cloud-44.env —
# osinfo-db doesn't yet ship a fedora44 short-id. Bump once it does.
OS_VARIANT="fedora-unknown"
DEFAULT_VCPUS="2"
DEFAULT_MEM_MIB="4096"
DEFAULT_DISK_GIB="20"
DEFAULT_USER="core"
