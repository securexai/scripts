# Pinned upstream OCI image + bootc-image-builder config for the Fedora 43
# Kinoite VM target. Sourced by vm/scripts/lib/bib.sh::build_kinoite_qcow.
#
# Kinoite does not ship an official cloud-init qcow2 — we build one from the
# OCI image via bootc-image-builder. This is slow (10–20 min) and only needed
# when bumping the Kinoite base.
#
# To pin OCI_DIGEST after a bump:
#   podman pull quay.io/fedora-ostree-desktops/kinoite:43
#   podman inspect --format '{{.Digest}}' quay.io/fedora-ostree-desktops/kinoite:43
# Paste the resulting "sha256:..." string below.
#
# To pin BIB_VERSION: check https://quay.io/repository/centos-bootc/bootc-image-builder?tab=tags
# and prefer a numeric tag over "latest" once you've built once successfully.

## 2026-04-26: pointing at the locally-derived bootc image (cloud-init
## layered on top of centos-bootc:stream9 — see vm/Containerfile.bootc).
## Build with:
##   sudo podman build -t localhost/scripts-vm-bootc:latest \
##     -f vm/Containerfile.bootc vm/
## The original kinoite ref stays tracked in R-017 — bib `latest`
## metadata schema (DefaultRootFs) doesn't match either f43 base image,
## so the actual KDE-on-Fedora-43 intent needs upstream alignment.
##   ORIGINAL_OCI_REF="quay.io/fedora-ostree-desktops/kinoite:43"
##   ORIGINAL_OCI_DIGEST="sha256:8fae1047bfd91eb5a7c97416b7c9e7171ce596864da8e5056d714148c4a9225c"
OCI_REF="localhost/scripts-vm-bootc:latest"

# For local refs, OCI_DIGEST records the local image ID
# (sudo podman inspect --format '{{.Id}}'); cache-hit logic compares
# against this so a rebuild of the derived image invalidates correctly.
OCI_DIGEST="sha256:bb87e7842afaac3c92bb446faae725c1abf930faad5309c41645613120f0a49d"

# FIXME: pin a specific bib release tag once the first successful build is in.
BIB_VERSION="latest"

# Path to the bib config TOML, relative to vm/targets/.
BIB_CONFIG_REL="kinoite.toml"

# virt-install knobs (consumed by vm/scripts/subcommands/create.sh).
OS_VARIANT="fedora43"
DEFAULT_VCPUS="2"
DEFAULT_MEM_MIB="4096"
DEFAULT_DISK_GIB="20"
DEFAULT_USER="core"
