# Pinned upstream qcow2 for the Fedora 44 Cloud Base image.
# Sourced by vm/scripts/lib/images.sh::ensure_image.
#
# To update IMAGE_SHA256 (do this once per Fedora point release):
#   curl -fsSL https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-44-1.7-x86_64-CHECKSUM \
#     | grep -E '^SHA256.*Fedora-Cloud-Base-Generic.*x86_64\.qcow2'
# Pin the resulting hex digest below.
#
# When Fedora cuts a 44-1.X point release with a new qcow2 filename, update
# IMAGE_URL too. The monthly toolbox-bump routine does NOT touch this file —
# Fedora cloud image bumps are a separate cadence.

IMAGE_URL="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"

# Pinned 2026-04-29 from the signed Fedora-Cloud-44-1.7-x86_64-CHECKSUM file.
# Bump in lockstep with IMAGE_URL when Fedora cuts a new 44-1.x point release.
IMAGE_SHA256="28680fe5b371a5a82ebf43a31926e086a168e59949d03969c5093e7071f90b7f"

# virt-install knobs (consumed by vm/scripts/subcommands/create.sh).
# OS_VARIANT note: osinfo-db `v20251212` (latest tagged release as of
# 2026-04-29) and the in-tree osinfo-db RPM on F44 do NOT yet ship a
# `fedora44` short-id (verified locally via `osinfo-query os | grep fedora44`
# — empty). `fedora-unknown` is the libosinfo-recommended catch-all.
# Re-check after osinfo-db cuts a release with `fedora-44.xml.in` and bump
# both this and kinoite-44.env to "fedora44". Tracked under R-019.
OS_VARIANT="fedora-unknown"
DEFAULT_VCPUS="2"
DEFAULT_MEM_MIB="2048"
DEFAULT_DISK_GIB="10"
DEFAULT_USER="fedora"
